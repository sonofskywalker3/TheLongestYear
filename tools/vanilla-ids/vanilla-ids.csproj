<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generator for src/TheLongestYear.Core/VanillaItemIds.Generated.cs and
       VanillaBundleBoard.Generated.cs. Reads the UNMODDED game content straight from the
       game's Content folder (no SMAPI, so no mod's asset edits). The run command is in the
       header of Program.cs. Both arguments are optional; the defaults are the Steam install
       path and the Core folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MonoGame.Framework"><HintPath>$(GamePath)\MonoGame.Framework.dll</HintPath></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GamePath)\StardewValley.GameData.dll</HintPath></Reference>
  </ItemGroup>
</Project>
